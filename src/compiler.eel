;; The EELisp compiler, written in EELisp: forms in, bytecode for the VM out (src/vm.rs).
;; See docs/self-hosting/ for how it works, and docs/plans/roadmap.md for the plan.
;;
;;   (compile form)      → a (proto …) form, the bytecode for one top-level form
;;   (compile-run form)  → compiles the form and runs it at the top level
;;
;; Local variables live in numbered slots of their function's frame, not in named scopes. A
;; variable an inner function uses is captured: the closure and the frame share it. Names that
;; aren't local are globals, looked up by name.
;;
;; Calls to a global builtin or function compile to register instructions (see "registers"
;; below); everything else to stack instructions. The two mix: a register result can be pushed,
;; a stack result popped into a register.
;;
;; Anything the compiler doesn't handle becomes an (interp form) instruction: the interpreter
;; evaluates that form. Only malformed forms (`(def x)`, `(if)`…) end up there, so their error
;; is the interpreter's own. `compiler-fallbacks` counts those places.
;;
;; Names starting with `compiler-` are its internals.

;; How many forms were left to the interpreter so far.
(def compiler-fallbacks 0)

;; A fresh jump label.
(def compiler-label-n 0)
(defn compiler-label ()
  (set! compiler-label-n (+ compiler-label-n 1))
  compiler-label-n)


;; Is x one of the symbols in names?
(defn compiler-member? (x names) (some? (fn (n) (= n x)) names))

;; The forms the interpreter treats specially, whatever the scope says — a dict, so asking is one
;; lookup, not a walk down a list for every form compiled.
(def compiler-specials
  (reduce (fn (d s) (dict-set d s true)) {}
          '(quote quasiquote if do begin def defn defun fn lambda defmacro set! let cond loop try recur and or for-each)))

;; The names a parameter list binds, in order: `(a b . rest)` binds a, b and rest.
(defn compiler-param-names (params)
  (filter (fn (p) (and (symbol? p) (!= (->string p) "."))) params))

;; Leave the form to the interpreter.
(defn compiler-interp (x out)
  (set! compiler-fallbacks (+ compiler-fallbacks 1))
  (out (list 'interp x)))

;; Code is built in one list per function (`out`, a list-builder): every compiling function adds
;; its instructions to it, so an instruction is made once and never copied by the forms around
;; it. (out i …) adds; (out) would end the list, so instructions always go in one or more at a
;; time.

;; Add every instruction of a list (one made for a block whose start depends on its end).
(defn compiler-emit-all (out code)
  (if (empty? code) nil (apply out code)))

;; ── where variables live ───────────────────────────────────────────────
;;
;; The compiler's picture of the program at any point is a context, `cx`:
;;   :fx   the function being compiled — {:id :slots :caps :parent :declared}: how many slots it
;;         uses so far, the outer variables it captures, the function it's inside, and every name
;;         declared anywhere in this top-level form (shared by all its functions)
;;   :lex  the blocks around this point, innermost first — {:fx :names :defs}: the variables
;;         each one binds, as a dict of name → slot, and which slots a `def` made
;; At the top level :lex is empty, and a `def` is global.

;; A mutable cell: (b) reads it, (b v) sets it. A box never holds nil, so a missing argument
;; means "read": one parameter, not a rest list, which every read would build and test.
(defn compiler-box (v)
  (let (val v)
    (fn (x) (if (nil? x) val (do (set! val x) val)))))

(def compiler-fx-n 0)

;; A new function, inside `parent` (nil at the top level).
(defn compiler-new-fx (parent)
  (set! compiler-fx-n (+ compiler-fx-n 1))
  {:id compiler-fx-n :slots (compiler-box 0) :temps (compiler-box 0) :caps (compiler-box (list)) :parent parent
   :declared (if (nil? parent) (compiler-box {}) (dict-get parent :declared))})

(defn compiler-new-slot (fx)
  (let (n ((dict-get fx :slots)))
    ((dict-get fx :slots) (+ n 1))
    n))

(defn compiler-new-block (fx)
  {:fx fx :names (compiler-box {}) :defs (compiler-box (list))})

;; Bind name in block, to a new slot of the block's function. A name bound again in the same
;; block gets a new slot, and references after that see the new one.
(defn compiler-declare (name block)
  (compiler-name-slot name block (compiler-new-slot (dict-get block :fx))))

;; Bind name in block to slot, a slot of the block's function.
(defn compiler-name-slot (name block slot)
  (let (declared (dict-get (dict-get block :fx) :declared))
    ((dict-get block :names) (dict-set ((dict-get block :names)) name slot))
    (declared (dict-set (declared) name true))
    slot))

;; Could name be local here? Only if it was declared somewhere in this top-level form: most names
;; a program uses (+, list, its own globals) never are, and this one lookup settles them.
(defn compiler-maybe-local? (name cx)
  (dict-has ((dict-get cx :declared)) name))

;; The slot name has in block, or nil.
(defn compiler-slot-in (name block)
  (dict-get ((dict-get block :names)) name))

;; cx, inside block.
(defn compiler-enter (cx block)
  {:lex (cons block (dict-get cx :lex)) :fx (dict-get block :fx) :declared (dict-get cx :declared)
   :tmp (dict-get cx :tmp)})

;; The innermost binding of name, as (block slot); nil when it's a global.
(defn compiler-find (name lex)
  (if (empty? lex)
    nil
    (let (slot (compiler-slot-in name (head lex)))
      (if (nil? slot) (compiler-find name (tail lex)) (list (head lex) slot)))))

(defn compiler-fx-id (fx) (dict-get fx :id))

;; The position of key among the (key …) entries, or nil.
(defn compiler-index (key entries i)
  (cond
    (empty? entries) nil
    (= (head (head entries)) key) i
    true (compiler-index key (tail entries) (+ i 1))))

;; The index under which fx captures slot `slot` of function `owner`. A new capture is added,
;; and so is every capture the functions in between need to pass it along.
(defn compiler-capture (fx owner slot)
  (let (caps ((dict-get fx :caps))
        key (list owner slot)
        known (compiler-index key caps 0))
    (if (not (nil? known))
      known
      (let (parent (dict-get fx :parent)
            src (if (= (compiler-fx-id parent) owner)
                  (list 'local slot)
                  (list 'cap (compiler-capture parent owner slot))))
        ((dict-get fx :caps) (append caps (list (list key src))))
        (length caps)))))

;; Where name lives, seen from cx: (local slot), (cap index), or nil for a global.
(defn compiler-resolve (name cx)
  (let (hit (if (compiler-maybe-local? name cx) (compiler-find name (dict-get cx :lex)) nil)
        here (compiler-fx-id (dict-get cx :fx)))
    (if (nil? hit)
      nil
      (let (owner (compiler-fx-id (dict-get (head hit) :fx)))
        (if (= owner here)
          (list 'local (second hit))
          (list 'cap (compiler-capture (dict-get cx :fx) owner (second hit))))))))

;; Is name bound locally here (so it isn't the global macro or builtin of that name)?
(defn compiler-local? (name cx)
  (and (compiler-maybe-local? name cx)
       (not (nil? (compiler-find name (dict-get cx :lex))))))

(defn compiler-load (name cx out)
  (let (r (compiler-resolve name cx))
    (cond
      (nil? r) (out (list 'load name))
      (= (head r) 'local) (out (list 'load-local (second r) name))
      true (out (list 'load-cap (second r) name)))))

(defn compiler-store (name cx out)
  (let (r (compiler-resolve name cx))
    (cond
      (nil? r) (out (list 'set name))
      (= (head r) 'local) (out (list 'set-local (second r) name))
      true (out (list 'set-cap (second r) name)))))

;; The slot a `def` of name binds in the current scope: the one it already has there, or a new
;; one. A new one is cleared each time its block starts again (`compiler-clears`).
(defn compiler-def-slot (name cx)
  (let (block (head (dict-get cx :lex))
        known (compiler-slot-in name block))
    (if (not (nil? known))
      known
      (let (slot (compiler-declare name block))
        ((dict-get block :defs) (cons slot ((dict-get block :defs))))
        slot))))

;; Instructions that unbind a block's `def` slots, so each run of the block starts without them.
;; They come first in the block but are known only once its body is compiled, so a block's code
;; is built in a list of its own and added after them (`compiler-block-out`).
(defn compiler-clears (block out)
  (for-each s (reverse ((dict-get block :defs))) (out (list 'clear-local s))))

;; A block's clears, then its code (built in `code`, a list-builder of its own), into out.
(defn compiler-block-out (block code out)
  (compiler-clears block out)
  (compiler-emit-all out (code)))

;; (def name value) with value's code added by (make-code). At the top level it's a global. In a
;; scope it binds a slot there; `early` binds the name before the value is compiled, so a
;; function can refer to itself.
(defn compiler-define (name cx early make-code out)
  (cond
    (empty? (dict-get cx :lex))
      (do (make-code) (out (list 'def name)))
    early
      (let (slot (compiler-def-slot name cx))
        (make-code)
        (out (list 'def-local slot)))
    true
      (do (make-code) (out (list 'def-local (compiler-def-slot name cx))))))

;; Is x a (fn …) or (lambda …) form?
(defn compiler-fn-form? (x)
  (and (list? x) (not (empty? x)) (compiler-member? (head x) '(fn lambda))))

;; ── expressions ────────────────────────────────────────────────────────
;; Every compile function takes the context, whether the form is in tail position (`tailp`), and
;; `out`, the list its instructions go into. Its code leaves the form's value on the stack.

(defn compiler-expr (x cx tailp out)
  (let (op (if tailp (compiler-operand x cx) nil))
    (cond
      ;; a variable or a constant in tail position is returned from where it is
      op (out (list 'return-value op))
      (symbol? x) (compiler-load x cx out)
      (list? x) (if (empty? x) (out (list 'const x)) (compiler-form x cx tailp out))
      (dict? x) (compiler-dict x cx out)
      true (out (list 'const x)))))

;; Forms in sequence: every value but the last is dropped. No forms is nil.
(defn compiler-body (forms cx tailp out)
  (cond
    (empty? forms) (out (list 'const nil))
    (empty? (tail forms)) (compiler-expr (head forms) cx tailp out)
    true (do (compiler-expr (head forms) cx false out)
             (out (list 'pop))
             (compiler-body (tail forms) cx tailp out))))

;; A dict literal: each value is evaluated, keys stay as written.
(defn compiler-dict (d cx out)
  (let (keys (dict-keys d))
    (for-each k keys (compiler-expr (dict-get d k) cx false out))
    (out (cons 'dict (map compiler-dict-key keys)))))

;; A key goes into the instruction as a keyword, `:name`, unless that wouldn't read back (`{"(" 1}`
;; or `{"a b" 1}`); then as a string. The VM takes either.
(def compiler-unsafe-in-keyword
  (reduce (fn (d c) (dict-set d c true)) {} '(" " "\n" "\t" "\r" "(" ")" "[" "]" "{" "}" "\"" ";" "'" "`" ",")))
(defn compiler-dict-key (k)
  (let (name (substr (->string k) 1))
    (if (some? (fn (c) (dict-has compiler-unsafe-in-keyword c)) (str-chars name)) name k)))

(defn compiler-form (x cx tailp out)
  (let (h (head x))
    (cond
      (not (symbol? h)) (compiler-call-at x cx tailp out)
      (dict-has compiler-specials h) (compiler-special h x cx tailp out)
      ;; what a global name means here — unless a local variable has that name
      true (compiler-global-call x cx tailp (if (compiler-local? h cx) nil (vm-global-kind h)) out))))

;; A call whose head is a name that isn't special, given what that name means (`kind`).
(defn compiler-global-call (x cx tailp kind out)
  (cond
    (= kind "macro") (compiler-expr (vm-macroexpand x) cx tailp out)
    ;; builtins that don't evaluate all their arguments (deftable, query, …)
    (= kind "raw") (compiler-call-with x cx tailp (fn (a i cx out) (out (list 'const a))) out)
    (= kind "table-first") (compiler-call-with x cx tailp compiler-table-arg out)
    (compiler-reg-call? kind x) (compiler-call-reg x cx tailp kind out)
    ;; a builtin of another arity takes its arguments from the stack anyway
    (= kind "builtin") (compiler-call x cx tailp out)
    ;; not known when compiling (defined later, or a local variable): whatever is there
    true (compiler-call-at x cx tailp out)))

;; A table command's first argument names the table as written — `(query contacts)` — unless
;; it is a call, which is evaluated: `(query (str "con" "tacts"))`. The rest are evaluated.
(defn compiler-table-arg (a i cx out)
  (if (and (= i 0) (not (and (list? a) (not (empty? a)))))
    (out (list 'const a))
    (compiler-expr a cx false out)))

;; A call: the function, then its arguments, then call (or tail-call).
(defn compiler-call (x cx tailp out)
  (compiler-call-with x cx tailp (fn (a i cx out) (compiler-expr a cx false out)) out))

;; A call whose arguments compile with (arg-code argument index cx out).
(defn compiler-call-with (x cx tailp arg-code out)
  (let (args (tail x))
    (compiler-expr (head x) cx false out)
    (compiler-args args 0 cx arg-code out)
    (out (list (if tailp 'tail-call 'call) (length args)))))

;; The arguments' code, in order: (arg-code argument index cx out) for each.
(defn compiler-args (args i cx arg-code out)
  (if (empty? args)
    nil
    (do (arg-code (head args) i cx out)
        (compiler-args (tail args) (+ i 1) cx arg-code out))))

;; ── registers ──────────────────────────────────────────────────────────
;; A call to a global builtin or function computes its arguments into registers and calls with
;; them in place (docs/self-hosting/16-registers.md). Registers are the function's slots: its
;; variables, then temporaries `(t k)`, numbered after every variable. Temporaries are used like a
;; stack: an expression computed into `(t d)` uses only `(t d)` and the ones above it, so a callee
;; entered at its argument registers, which owns everything above them while it runs, never
;; overwrites a value still needed. `:tmp` in the context is the first free temporary.

(defn compiler-tmp (k) (list 't k))
(defn compiler-tmp-base (cx) (or (dict-get cx :tmp) 0))

;; Note that temporary k is used: the function needs k + 1 of them at least.
(defn compiler-use-tmp (cx k)
  (let (temps (dict-get (dict-get cx :fx) :temps))
    (if (> (+ k 1) (temps)) (temps (+ k 1)) nil)))

;; x as an operand an instruction can read directly — (local i name), (cap i name) or (const v)
;; — or nil when it has to be computed first.
(defn compiler-operand (x cx)
  (cond
    (symbol? x)
      (let (r (compiler-resolve x cx))
        (cond
          (nil? r) nil
          (= (head r) 'local) (list 'local (second r) x)
          true (list 'cap (second r) x)))
    (list? x)
      (cond
        (empty? x) (list 'const x)
        (and (= (head x) 'quote) (= (length x) 2)) (list 'const (second x))
        true nil)
    (dict? x) nil
    true (list 'const x)))

;; What a call's head means, if it is a global name: the kind vm-global-kind gives, or nil.
(defn compiler-head-kind (x cx)
  (if (and (list? x) (not (empty? x)) (symbol? (head x))
           (not (dict-has compiler-specials (head x))) (not (compiler-local? (head x) cx)))
    (vm-global-kind (head x))
    nil))

;; Code leaving x's value in temporary d.
(defn compiler-to-reg (x cx d out) (compiler-to-dest x cx d (compiler-tmp d) out))

;; Code leaving x's value in register r, using temporaries from d up. r is (t d) or a variable's
;; slot (a let binding computed straight into it).
(defn compiler-to-dest (x cx d r out)
  (compiler-use-tmp cx d)
  (let (op (compiler-operand x cx))
    (cond
      op (out (list 'move r op))
      (symbol? x) (out (list 'global r x))
      true
        (let (kind (compiler-head-kind x cx))
          (cond
            (= kind "macro") (compiler-to-dest (vm-macroexpand x) cx d r out)
            (compiler-reg-call? kind x) (compiler-call-into x cx d kind r out)
            (compiler-call-at? x kind)
              (if (compiler-into-special? x)
                (compiler-special-into x (dict-set cx :tmp d) d r out)
                (compiler-call-at-into x cx d r out))
            true (do (compiler-to-stack x (dict-set cx :tmp d) kind out)
                     (out (list 'pop-to r))))))))

;; if, and, or: computed into a register, with jumps, not through the stack. (compiler-head-kind
;; gives them no kind, as for any special form, so they arrive here with the calls.)
(def compiler-into-specials {"if" true "and" true "or" true})
(defn compiler-into-special? (x) (and (symbol? (head x)) (dict-has compiler-into-specials (head x))))

(defn compiler-special-into (x cx d r out)
  (let (h (head x) n (length x))
    (cond
      (= h 'if)
        (if (< n 3)
          (do (compiler-expr x cx false out) (out (list 'pop-to r)))
          (let (else-l (compiler-label) end-l (compiler-label))
            (compiler-jump-unless (nth x 1) cx else-l out)
            (compiler-to-dest (nth x 2) cx d r out)
            (out (list 'jump end-l) (list 'label else-l))
            (if (> n 3) (compiler-to-dest (nth x 3) cx d r out) (out (list 'move r (list 'const nil))))
            (out (list 'label end-l))))
      (= n 1) (out (list 'move r (list 'const (= h 'and))))
      (= h 'and) (compiler-and-into (tail x) cx d r (compiler-label) out)
      true (compiler-or-into (tail x) cx d r (compiler-label) out))))

;; and: each value into r; a false one ends it, and is its value.
(defn compiler-and-into (forms cx d r end-l out)
  (compiler-to-dest (head forms) cx d r out)
  (if (empty? (tail forms))
    (out (list 'label end-l))
    (do (out (list 'jump-if-not r end-l))
        (compiler-and-into (tail forms) cx d r end-l out))))

;; or: each value into r; a true one ends it, and is its value.
(defn compiler-or-into (forms cx d r end-l out)
  (compiler-to-dest (head forms) cx d r out)
  (if (empty? (tail forms))
    (out (list 'label end-l))
    (let (next-l (compiler-label))
      (out (list 'jump-if-not r next-l) (list 'jump end-l) (list 'label next-l))
      (compiler-or-into (tail forms) cx d r end-l out))))

;; x's code for the stack, when compiler-head-kind already said what its head means.
(defn compiler-to-stack (x cx kind out)
  (if (nil? kind)
    (compiler-expr x cx false out)
    (compiler-global-call x cx false kind out)))

;; Each argument into its temporary, from d up, in order.
(defn compiler-args-to (args cx d out)
  (if (empty? args)
    nil
    (do (compiler-to-reg (head args) cx d out)
        (compiler-args-to (tail args) cx (+ d 1) out))))

;; Is this call worth registers? A builtin of one or two arguments is a call1 or call2, whose
;; operands are read where they are (the arithmetic and the intrinsics run inside it). A
;; function is entered at its argument registers. Any other builtin call is cheaper as stack
;; code: the builtin takes its arguments from the stack anyway.
(defn compiler-reg-call? (kind x)
  (or (= kind "function") (and (= kind "builtin") (or (= (length x) 3) (= (length x) 2)))))

;; A call of a global, its result into register r (see compiler-reg-call?), its arguments in
;; temporaries from d up. A first operand that is a variable is copied before a second one that
;; must be computed, in case computing it changes the variable; reading a global changes nothing.
(defn compiler-call-into (x cx d kind r out)
  (let (f (head x) args (tail x))
    (compiler-use-tmp cx d)
    (cond
      (and (= kind "builtin") (empty? (tail args)))
        (let (a (compiler-operand (head args) cx))
          (if a nil (compiler-to-reg (head args) cx d out))
          (out (list 'call1 r f (if a a (compiler-tmp d)))))
      (= kind "builtin")
        (let (a (compiler-operand (head args) cx)
              b (compiler-operand (second args) cx)
              a-now (and a (or b (= (head a) 'const) (symbol? (second args)))))
          (if a-now nil (compiler-to-reg (head args) cx d out))
          (if b nil (compiler-to-reg (second args) cx (+ d 1) out))
          (out (list 'call2 r f (if a-now a (compiler-tmp d)) (if b b (compiler-tmp (+ d 1))))))
      true
        (do (compiler-args-to args cx d out)
            (out (list 'call-global r f (compiler-tmp d) (length args)))))))

;; A call of a global, its value left on the stack (or, in tail position, a tail call).
(defn compiler-call-reg (x cx tailp kind out)
  (let (d (compiler-tmp-base cx) args (tail x))
    (cond
      (and tailp (= kind "function"))
        (do (compiler-use-tmp cx d)
            (compiler-args-to args cx d out)
            (out (list 'tail-call-global (head x) (compiler-tmp d) (length args))))
      (and (= kind "builtin") (empty? (tail args)) (compiler-operand (head args) cx))
        (out (list 'call1 'push (head x) (compiler-operand (head args) cx)))
      (= kind "builtin")
        (let (a (compiler-operand (head args) cx) b (and a (not (empty? (tail args))) (compiler-operand (second args) cx)))
          (if b
            (out (list 'call2 'push (head x) a b))
            (do (compiler-call-into x cx d kind (compiler-tmp d) out) (out (list 'push (compiler-tmp d))))))
      true (do (compiler-call-into x cx d kind (compiler-tmp d) out) (out (list 'push (compiler-tmp d)))))))

;; A call compiled with call-at: one whose head is a local variable, a global not known when
;; compiling (a function defined later, or the one being defined), or not a name at all. (The
;; special forms if, and, or get here too, and compiler-to-dest sends them on.)
(defn compiler-call-at? (x kind)
  (and (nil? kind) (list? x) (not (empty? x))
       (not (and (symbol? (head x)) (dict-has compiler-specials (head x))
                 (not (compiler-into-special? x))))))

;; The function into temporary d, then its arguments after it, then call-at into r: the
;; function is read first, as stack code reads it, so a name that isn't defined fails before any
;; argument is computed.
(defn compiler-call-at-into (x cx d r out)
  (compiler-use-tmp cx d)
  (compiler-to-reg (head x) cx d out)
  (compiler-args-to (tail x) cx (+ d 1) out)
  (out (list 'call-at r (compiler-tmp d) (length (tail x)))))

;; The same, its value left on the stack (or, in tail position, a tail call).
(defn compiler-call-at (x cx tailp out)
  (let (d (compiler-tmp-base cx))
    (if tailp
      (do (compiler-use-tmp cx d)
          (compiler-to-reg (head x) cx d out)
          (compiler-args-to (tail x) cx (+ d 1) out)
          (out (list 'tail-call-at (compiler-tmp d) (length (tail x)))))
      (do (compiler-call-at-into x cx d (compiler-tmp d) out)
          (out (list 'push (compiler-tmp d)))))))

;; Jump to label unless test is true: a register test needs no trip through the stack.
(defn compiler-jump-unless (test cx label out)
  (let (op (compiler-operand test cx))
    (cond
      op (out (list 'jump-if-not op label))
      ;; (and a b): unless a, unless b
      (and (list? test) (> (length test) 1) (= (head test) 'and))
        (for-each f (tail test) (compiler-jump-unless f cx label out))
      ;; (or a b): if a, go on; if b, go on; otherwise jump
      (and (list? test) (> (length test) 1) (= (head test) 'or))
        (let (go-l (compiler-label) forms (tail test))
          (for-each f (take (- (length forms) 1) forms)
            (let (next-l (compiler-label))
              (compiler-jump-unless f cx next-l out)
              (out (list 'jump go-l) (list 'label next-l))))
          (compiler-jump-unless (last forms) cx label out)
          (out (list 'label go-l)))
      true
        (let (kind (compiler-head-kind test cx) d (compiler-tmp-base cx))
          (cond
            (compiler-reg-call? kind test)
              (do (compiler-call-into test cx d kind (compiler-tmp d) out)
                  (out (list 'jump-if-not (compiler-tmp d) label)))
            (compiler-call-at? test kind)
              (do (if (compiler-into-special? test)
                    (compiler-special-into test (dict-set cx :tmp d) d (compiler-tmp d) out)
                    (compiler-call-at-into test cx d (compiler-tmp d) out))
                  (out (list 'jump-if-not (compiler-tmp d) label)))
            true (do (compiler-expr test cx false out) (out (list 'jump-if-false label))))))))

;; ── special forms ──────────────────────────────────────────────────────

(defn compiler-special (h x cx tailp out)
  (let (n (length x))
    (cond
      (= h 'quote) (out (list 'const (if (> n 1) (nth x 1) nil)))
      (= h 'if) (if (< n 3) (compiler-interp x out) (compiler-if x cx tailp out))
      (or (= h 'do) (= h 'begin)) (compiler-body (tail x) cx tailp out)
      (= h 'def) (compiler-def x cx out)
      (or (= h 'defn) (= h 'defun)) (compiler-defn x cx out)
      (or (= h 'fn) (= h 'lambda))
        (if (and (> n 1) (list? (nth x 1)))
          (out (list 'closure (compiler-proto nil (nth x 1) (drop 2 x) cx)))
          (compiler-interp x out))
      (= h 'set!)
        (if (and (> n 2) (symbol? (nth x 1)))
          (do (compiler-expr (nth x 2) cx false out)
              (compiler-store (nth x 1) cx out))
          (compiler-interp x out))
      (= h 'let) (if (< n 2) (compiler-interp x out) (compiler-let x cx tailp out))
      (= h 'cond) (compiler-cond (tail x) cx tailp (compiler-label) out)
      (= h 'and) (if (= n 1) (out (list 'const true)) (compiler-andor (tail x) cx tailp 'jump-if-false-or-pop (compiler-label) out))
      (= h 'or) (if (= n 1) (out (list 'const false)) (compiler-andor (tail x) cx tailp 'jump-if-true-or-pop (compiler-label) out))
      (= h 'loop) (if (< n 2) (compiler-interp x out) (compiler-loop x cx out))
      (= h 'recur)
        (do (for-each a (tail x) (compiler-expr a cx false out))
            (out (list 'recur (- n 1))))
      (= h 'try) (compiler-try x cx tailp out)
      (= h 'quasiquote) (compiler-qq (if (> n 1) (nth x 1) nil) cx out)
      (= h 'for-each) (if (< n 3) (compiler-interp x out) (compiler-for-each x cx out))
      (= h 'defmacro) (compiler-defmacro x cx out)
      true (compiler-interp x out))))

(defn compiler-if (x cx tailp out)
  (let (else-l (compiler-label) end-l (compiler-label))
    (compiler-jump-unless (nth x 1) cx else-l out)
    (compiler-expr (nth x 2) cx tailp out)
    (out (list 'jump end-l) (list 'label else-l))
    (if (> (length x) 3) (compiler-expr (nth x 3) cx tailp out) (out (list 'const nil)))
    (out (list 'label end-l))))

;; A function body, as a proto: a new function whose first slots are its parameters. Its code is
;; built in a list of its own.
(defn compiler-proto (name params body cx)
  (let (fx (compiler-new-fx (dict-get cx :fx))
        block (compiler-new-block fx)
        code (list-builder))
    (for-each p (compiler-param-names params) (compiler-declare p block))
    (compiler-body body (compiler-enter (dict-set cx :tmp 0) block) true code)
    (list 'proto :name name :params params :source body
          :slots ((dict-get fx :slots)) :temps ((dict-get fx :temps))
          :captures (map second ((dict-get fx :caps)))
          :code (code))))

(defn compiler-def (x cx out)
  (cond
    (< (length x) 3) (compiler-interp x out)
    (symbol? (nth x 1))
      (compiler-define (nth x 1) cx (compiler-fn-form? (nth x 2))
                       (fn () (compiler-expr (nth x 2) cx false out)) out)
    ;; (def (name params…) body…)
    (and (list? (nth x 1)) (not (empty? (nth x 1))) (symbol? (head (nth x 1))))
      (let (name (head (nth x 1)))
        (compiler-define name cx true
                         (fn () (out (list 'closure (compiler-proto name (tail (nth x 1)) (drop 2 x) cx)))) out))
    true (compiler-interp x out)))

(defn compiler-defn (x cx out)
  (if (and (>= (length x) 3) (symbol? (nth x 1)) (list? (nth x 2)))
    (compiler-define (nth x 1) cx true
                     (fn () (out (list 'closure (compiler-proto (nth x 1) (nth x 2) (drop 3 x) cx)))) out)
    (compiler-interp x out)))

;; The (name value) pairs of a let: flat `(a 1 b 2)` or nested `((a 1) (b 2))`. A pair whose
;; name isn't a symbol binds nothing, as in the interpreter.
(defn compiler-flat-pairs (binds)
  (if (< (length binds) 2)
    (list)
    (let (rest (compiler-flat-pairs (drop 2 binds)))
      (if (symbol? (head binds)) (cons (list (head binds) (second binds)) rest) rest))))

(defn compiler-let-pairs (binds)
  (cond
    (not (list? binds)) (list)
    (empty? binds) (list)
    (symbol? (head binds)) (compiler-flat-pairs binds)
    true (filter (fn (p) (and (list? p) (>= (length p) 2) (symbol? (head p)))) binds)))

;; Each value is computed straight into its slot, with the bindings before it in view (let*):
;; the slot is taken first, the name bound to it only after the value is compiled. The code goes
;; into out; the slots are returned, in order.
(defn compiler-bind (pairs block cx out)
  (let (slots (list-builder) d (compiler-tmp-base cx) fx (dict-get block :fx))
    (for-each p pairs
      (let (slot (compiler-new-slot fx))
        (compiler-to-dest (second p) cx d slot out)
        (compiler-name-slot (head p) block slot)
        (slots slot)))
    (slots)))

(defn compiler-let (x cx tailp out)
  (let (block (compiler-new-block (dict-get cx :fx))
        inner (compiler-enter cx block)
        code (list-builder))
    (compiler-bind (compiler-let-pairs (nth x 1)) block inner code)
    (compiler-body (drop 2 x) inner tailp code)
    (compiler-block-out block code out)))

;; Flat cond: test, result, test, result…; `else`, `otherwise` and `true` always match.
(defn compiler-cond (clauses cx tailp end-l out)
  (if (< (length clauses) 2)
    (out (list 'const nil) (list 'label end-l))
    (let (test (head clauses) result (second clauses) next-l (compiler-label))
      (if (and (symbol? test) (compiler-member? test '(else otherwise)))
        (do (compiler-expr result cx tailp out) (out (list 'label end-l)))
        (do (compiler-jump-unless test cx next-l out)
            (compiler-expr result cx tailp out)
            (out (list 'jump end-l) (list 'label next-l))
            (compiler-cond (drop 2 clauses) cx tailp end-l out))))))

;; and / or: every value but the last can end the form early.
(defn compiler-andor (forms cx tailp jump end-l out)
  (if (empty? (tail forms))
    (do (compiler-expr (head forms) cx tailp out) (out (list 'label end-l)))
    (do (compiler-expr (head forms) cx false out)
        (out (list jump end-l))
        (compiler-andor (tail forms) cx tailp jump end-l out))))

;; (loop (a 1 b 2) body): the body is one form; `recur` rebinds the slots and starts it again.
(defn compiler-loop (x cx out)
  (let (block (compiler-new-block (dict-get cx :fx))
        inner (compiler-enter cx block)
        code (list-builder)
        slots (compiler-bind (if (list? (nth x 1)) (compiler-flat-pairs (nth x 1)) (list)) block inner code))
    (code (cons 'loop-slots slots))
    (if (> (length x) 2) (compiler-expr (nth x 2) inner false code) (code (list 'const nil)))
    (code (list 'end-loop))
    (compiler-block-out block code out)))

;; (try body… (catch e handler…)). The body is never a tail call: its error must land here.
(defn compiler-try (x cx tailp out)
  (let (last-form (last x)
        catch? (and (> (length x) 1) (list? last-form) (not (empty? last-form)) (= (head last-form) 'catch))
        body (if catch? (take (- (length x) 2) (tail x)) (tail x))
        catch-l (compiler-label)
        end-l (compiler-label))
    (out (list 'try catch-l))
    (compiler-body body cx false out)
    (out (list 'end-try) (list 'jump end-l) (list 'label catch-l))
    (if catch? (compiler-catch last-form cx tailp out) (out (list 'pop) (list 'const nil)))
    (out (list 'label end-l))))

;; The handler runs with the error dict on the stack, bound to the catch name if there is one.
(defn compiler-catch (c cx tailp out)
  (let (name (if (> (length c) 1) (nth c 1) nil)
        block (compiler-new-block (dict-get cx :fx))
        inner (compiler-enter cx block)
        code (list-builder))
    (if (symbol? name)
      (code (list 'init-local (compiler-declare name block)))
      (code (list 'pop)))
    (compiler-body (drop 2 c) inner tailp code)
    (compiler-block-out block code out)))

;; Is x a two-element form headed by the symbol name — (unquote v), (unquote-splicing v)?
(defn compiler-unquote? (x name)
  (and (list? x) (= (length x) 2) (= (head x) name)))

;; A quasiquote template: lists are rebuilt, ,x is evaluated, ,@x is spliced in, anything else
;; (dicts included) stays as written.
(defn compiler-qq (e cx out)
  (cond
    (not (list? e)) (out (list 'const e))
    (compiler-unquote? e 'unquote) (compiler-expr (second e) cx false out)
    true (do (for-each it e
               (if (compiler-unquote? it 'unquote-splicing)
                 (compiler-expr (second it) cx false out)
                 (compiler-qq it cx out)))
             (out (cons 'make-list
                        (map (fn (it) (if (compiler-unquote? it 'unquote-splicing) 'splice 'item)) e))))))

;; (for-each var list body…): the body runs once per element, in a fresh scope binding var, and
;; the form is nil. A var that isn't a symbol makes the whole form nil, list unevaluated.
(defn compiler-for-each (x cx out)
  (let (var (nth x 1))
    (if (not (symbol? var))
      (out (list 'const nil))
      (let (top-l (compiler-label) end-l (compiler-label))
        (compiler-expr (nth x 2) cx false out)
        (out (list 'const 0) (list 'label top-l) (list 'next-item end-l))
        (let (block (compiler-new-block (dict-get cx :fx))
              inner (compiler-enter cx block)
              code (list-builder))
          (code (list 'init-local (compiler-declare var block)))
          (for-each f (drop 3 x)
            (compiler-expr f inner false code)
            (code (list 'pop)))
          (compiler-block-out block code out))
        (out (list 'jump top-l) (list 'label end-l) (list 'const nil))))))

;; (defmacro name (params) body…): the expander is compiled like a function body; it runs, at
;; compile time, on the unevaluated argument forms.
(defn compiler-defmacro (x cx out)
  (if (and (>= (length x) 3) (symbol? (nth x 1)) (list? (nth x 2)))
    (compiler-define (nth x 1) cx true
                     (fn () (out (list 'macro (compiler-proto (nth x 1) (nth x 2) (drop 3 x) cx)))) out)
    (compiler-interp x out)))

;; ── entry points ───────────────────────────────────────────────────────

;; The bytecode for one top-level form, as a (proto …) form.
(defn compile (form)
  (let (fx (compiler-new-fx nil)
        code (list-builder))
    (compiler-expr form {:lex (list) :fx fx :declared (dict-get fx :declared) :tmp 0} true code)
    (list 'proto :name nil :params (list) :source (list form)
          :slots ((dict-get fx :slots)) :temps ((dict-get fx :temps)) :captures (list) :code (code))))

;; Compile a top-level form and run it, in the global scope.
(defn compile-run (form) (vm-run (compile form)))
