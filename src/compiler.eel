;; The EELisp compiler, written in EELisp: forms in, bytecode for the VM out (src/vm.rs).
;; See docs/self-hosting/ for how it works, and docs/plans/roadmap.md for the plan.
;;
;;   (compile form)      → a (proto …) form, the bytecode for one top-level form
;;   (compile-run form)  → compiles the form and runs it at the top level
;;
;; Local variables live in numbered slots of their function's frame, not in named scopes. A
;; variable an inner function uses is captured: the closure and the frame share it. Names that
;; aren't local are globals, looked up by name.
;;
;; Calls to a global builtin or function compile to register instructions (see "registers"
;; below); everything else to stack instructions. The two mix: a register result can be pushed,
;; a stack result popped into a register.
;;
;; Anything the compiler doesn't handle becomes an (interp form) instruction: the interpreter
;; evaluates that form. Only malformed forms (`(def x)`, `(if)`…) end up there, so their error
;; is the interpreter's own. `compiler-fallbacks` counts those places.
;;
;; Names starting with `compiler-` are its internals.

;; How many forms were left to the interpreter so far.
(def compiler-fallbacks 0)

;; A fresh jump label.
(def compiler-label-n 0)
(defn compiler-label ()
  (set! compiler-label-n (+ compiler-label-n 1))
  compiler-label-n)

;; Concatenate any number of instruction lists.
(defn compiler-cat (. parts) (reduce append (list) parts))

;; Is x one of the symbols in names?
(defn compiler-member? (x names) (some? (fn (n) (= n x)) names))

;; The forms the interpreter treats specially, whatever the scope says — a dict, so asking is one
;; lookup, not a walk down a list for every form compiled.
(def compiler-specials
  (reduce (fn (d s) (dict-set d s true)) {}
          '(quote quasiquote if do begin def defn defun fn lambda defmacro set! let cond loop try recur and or for-each)))

;; The names a parameter list binds, in order: `(a b . rest)` binds a, b and rest.
(defn compiler-param-names (params)
  (filter (fn (p) (and (symbol? p) (!= (->string p) "."))) params))

;; Leave the form to the interpreter.
(defn compiler-interp (x)
  (set! compiler-fallbacks (+ compiler-fallbacks 1))
  (list (list 'interp x)))

(defn compiler-const (v) (list (list 'const v)))

;; ── where variables live ───────────────────────────────────────────────
;;
;; The compiler's picture of the program at any point is a context, `cx`:
;;   :fx   the function being compiled — {:id :slots :caps :parent :declared}: how many slots it
;;         uses so far, the outer variables it captures, the function it's inside, and every name
;;         declared anywhere in this top-level form (shared by all its functions)
;;   :lex  the blocks around this point, innermost first — {:fx :names :defs}: the variables
;;         each one binds, as a dict of name → slot, and which slots a `def` made
;; At the top level :lex is empty, and a `def` is global.

;; A mutable cell: (b) reads it, (b v) sets it.
(defn compiler-box (v)
  (let (val v)
    (fn (. args) (if (empty? args) val (do (set! val (head args)) val)))))

(def compiler-fx-n 0)

;; A new function, inside `parent` (nil at the top level).
(defn compiler-new-fx (parent)
  (set! compiler-fx-n (+ compiler-fx-n 1))
  {:id compiler-fx-n :slots (compiler-box 0) :temps (compiler-box 0) :caps (compiler-box (list)) :parent parent
   :declared (if (nil? parent) (compiler-box {}) (dict-get parent :declared))})

(defn compiler-new-slot (fx)
  (let (n ((dict-get fx :slots)))
    ((dict-get fx :slots) (+ n 1))
    n))

(defn compiler-new-block (fx)
  {:fx fx :names (compiler-box {}) :defs (compiler-box (list))})

;; Bind name in block, to a new slot of the block's function. A name bound again in the same
;; block gets a new slot, and references after that see the new one.
(defn compiler-declare (name block)
  (let (fx (dict-get block :fx)
        slot (compiler-new-slot fx)
        declared (dict-get fx :declared))
    ((dict-get block :names) (dict-set ((dict-get block :names)) name slot))
    (declared (dict-set (declared) name true))
    slot))

;; Could name be local here? Only if it was declared somewhere in this top-level form: most names
;; a program uses (+, list, its own globals) never are, and this one lookup settles them.
(defn compiler-maybe-local? (name cx)
  (dict-has ((dict-get cx :declared)) name))

;; The slot name has in block, or nil.
(defn compiler-slot-in (name block)
  (dict-get ((dict-get block :names)) name))

;; cx, inside block.
(defn compiler-enter (cx block)
  {:lex (cons block (dict-get cx :lex)) :fx (dict-get block :fx) :declared (dict-get cx :declared)
   :tmp (dict-get cx :tmp)})

;; The innermost binding of name, as (block slot); nil when it's a global.
(defn compiler-find (name lex)
  (if (empty? lex)
    nil
    (let (slot (compiler-slot-in name (head lex)))
      (if (nil? slot) (compiler-find name (tail lex)) (list (head lex) slot)))))

(defn compiler-fx-id (fx) (dict-get fx :id))

;; The position of key among the (key …) entries, or nil.
(defn compiler-index (key entries i)
  (cond
    (empty? entries) nil
    (= (head (head entries)) key) i
    true (compiler-index key (tail entries) (+ i 1))))

;; The index under which fx captures slot `slot` of function `owner`. A new capture is added,
;; and so is every capture the functions in between need to pass it along.
(defn compiler-capture (fx owner slot)
  (let (caps ((dict-get fx :caps))
        key (list owner slot)
        known (compiler-index key caps 0))
    (if (not (nil? known))
      known
      (let (parent (dict-get fx :parent)
            src (if (= (compiler-fx-id parent) owner)
                  (list 'local slot)
                  (list 'cap (compiler-capture parent owner slot))))
        ((dict-get fx :caps) (append caps (list (list key src))))
        (length caps)))))

;; Where name lives, seen from cx: (local slot), (cap index), or nil for a global.
(defn compiler-resolve (name cx)
  (let (hit (if (compiler-maybe-local? name cx) (compiler-find name (dict-get cx :lex)) nil)
        here (compiler-fx-id (dict-get cx :fx)))
    (if (nil? hit)
      nil
      (let (owner (compiler-fx-id (dict-get (head hit) :fx)))
        (if (= owner here)
          (list 'local (second hit))
          (list 'cap (compiler-capture (dict-get cx :fx) owner (second hit))))))))

;; Is name bound locally here (so it isn't the global macro or builtin of that name)?
(defn compiler-local? (name cx)
  (and (compiler-maybe-local? name cx)
       (not (nil? (compiler-find name (dict-get cx :lex))))))

(defn compiler-load (name cx)
  (let (r (compiler-resolve name cx))
    (cond
      (nil? r) (list (list 'load name))
      (= (head r) 'local) (list (list 'load-local (second r) name))
      true (list (list 'load-cap (second r) name)))))

(defn compiler-store (name cx)
  (let (r (compiler-resolve name cx))
    (cond
      (nil? r) (list (list 'set name))
      (= (head r) 'local) (list (list 'set-local (second r) name))
      true (list (list 'set-cap (second r) name)))))

;; The slot a `def` of name binds in the current scope: the one it already has there, or a new
;; one. A new one is cleared each time its block starts again (`compiler-clears`).
(defn compiler-def-slot (name cx)
  (let (block (head (dict-get cx :lex))
        known (compiler-slot-in name block))
    (if (not (nil? known))
      known
      (let (slot (compiler-declare name block))
        ((dict-get block :defs) (cons slot ((dict-get block :defs))))
        slot))))

;; Instructions that unbind a block's `def` slots, so each run of the block starts without them.
(defn compiler-clears (block)
  (map (fn (s) (list 'clear-local s)) (reverse ((dict-get block :defs)))))

;; (def name value) with value's code from (make-code). At the top level it's a global. In a
;; scope it binds a slot there; `early` binds the name before the value is compiled, so a
;; function can refer to itself.
(defn compiler-define (name cx early make-code)
  (cond
    (empty? (dict-get cx :lex))
      (compiler-cat (make-code) (list (list 'def name)))
    early
      (let (slot (compiler-def-slot name cx))
        (compiler-cat (make-code) (list (list 'def-local slot))))
    true
      (let (code (make-code))
        (compiler-cat code (list (list 'def-local (compiler-def-slot name cx)))))))

;; Is x a (fn …) or (lambda …) form?
(defn compiler-fn-form? (x)
  (and (list? x) (not (empty? x)) (compiler-member? (head x) '(fn lambda))))

;; ── expressions ────────────────────────────────────────────────────────
;; Every compile function takes the context and whether the form is in tail position (`tailp`),
;; and returns a list of instructions that leaves the form's value on the stack.

(defn compiler-expr (x cx tailp)
  (cond
    ;; a variable or a constant in tail position is returned from where it is
    (and tailp (compiler-operand x cx)) (list (list 'return-value (compiler-operand x cx)))
    (symbol? x) (compiler-load x cx)
    (list? x) (if (empty? x) (compiler-const x) (compiler-form x cx tailp))
    (dict? x) (compiler-dict x cx)
    true (compiler-const x)))

;; Forms in sequence: every value but the last is dropped. No forms is nil.
(defn compiler-body (forms cx tailp)
  (cond
    (empty? forms) (compiler-const nil)
    (empty? (tail forms)) (compiler-expr (head forms) cx tailp)
    true (let (first-code (compiler-expr (head forms) cx false))
           (append (append first-code (list (list 'pop)))
                   (compiler-body (tail forms) cx tailp)))))

;; A dict literal: each value is evaluated, keys stay as written.
(defn compiler-dict (d cx)
  (let (keys (dict-keys d))
    (compiler-cat
      (reduce (fn (acc k) (append acc (compiler-expr (dict-get d k) cx false))) (list) keys)
      (list (cons 'dict (map compiler-dict-key keys))))))

;; A key goes into the instruction as a keyword, `:name`, unless that wouldn't read back (`{"(" 1}`
;; or `{"a b" 1}`); then as a string. The VM takes either.
(def compiler-unsafe-in-keyword
  (reduce (fn (d c) (dict-set d c true)) {} '(" " "\n" "\t" "\r" "(" ")" "[" "]" "{" "}" "\"" ";" "'" "`" ",")))
(defn compiler-dict-key (k)
  (let (name (substr (->string k) 1))
    (if (some? (fn (c) (dict-has compiler-unsafe-in-keyword c)) (str-chars name)) name k)))

(defn compiler-form (x cx tailp)
  (let (h (head x))
    (cond
      (not (symbol? h)) (compiler-call-at x cx tailp)
      (dict-has compiler-specials h) (compiler-special h x cx tailp)
      ;; what a global name means here — unless a local variable has that name
      true (compiler-global-call x cx tailp (if (compiler-local? h cx) nil (vm-global-kind h))))))

;; A call whose head is a name that isn't special, given what that name means (`kind`).
(defn compiler-global-call (x cx tailp kind)
  (cond
    (= kind "macro") (compiler-expr (vm-macroexpand x) cx tailp)
    ;; builtins that don't evaluate all their arguments (deftable, query, …)
    (= kind "raw") (compiler-call-with x cx tailp (fn (a i cx) (compiler-const a)))
    (= kind "table-first") (compiler-call-with x cx tailp compiler-table-arg)
    (compiler-reg-call? kind x) (compiler-call-reg x cx tailp kind)
    ;; a builtin of another arity takes its arguments from the stack anyway
    (= kind "builtin") (compiler-call x cx tailp)
    ;; not known when compiling (defined later, or a local variable): whatever is there
    true (compiler-call-at x cx tailp)))

;; A table command's first argument names the table as written — `(query contacts)` — unless
;; it is a call, which is evaluated: `(query (str "con" "tacts"))`. The rest are evaluated.
(defn compiler-table-arg (a i cx)
  (if (and (= i 0) (not (and (list? a) (not (empty? a)))))
    (compiler-const a)
    (compiler-expr a cx false)))

;; A call: the function, then its arguments, then call (or tail-call).
(defn compiler-call (x cx tailp)
  (compiler-call-with x cx tailp (fn (a i cx) (compiler-expr a cx false))))

;; A call whose arguments compile with (arg-code argument index cx).
(defn compiler-call-with (x cx tailp arg-code)
  (let (args (tail x)
        f-code (compiler-expr (head x) cx false))
    (append
      (append f-code (compiler-args args 0 cx arg-code))
      (list (list (if tailp 'tail-call 'call) (length args))))))

;; The arguments' code, in order: (arg-code argument index cx) for each.
(defn compiler-args (args i cx arg-code)
  (if (empty? args)
    (list)
    (let (code (arg-code (head args) i cx))
      (append code (compiler-args (tail args) (+ i 1) cx arg-code)))))

;; ── registers ──────────────────────────────────────────────────────────
;; A call to a global builtin or function computes its arguments into registers and calls with
;; them in place (docs/self-hosting/16-registers.md). Registers are the function's slots: its
;; variables, then temporaries `(t k)`, numbered after every variable. Temporaries are used like a
;; stack: an expression computed into `(t d)` uses only `(t d)` and the ones above it, so a callee
;; entered at its argument registers, which owns everything above them while it runs, never
;; overwrites a value still needed. `:tmp` in the context is the first free temporary.

(defn compiler-tmp (k) (list 't k))
(defn compiler-tmp-base (cx) (or (dict-get cx :tmp) 0))

;; Note that temporary k is used: the function needs k + 1 of them at least.
(defn compiler-use-tmp (cx k)
  (let (temps (dict-get (dict-get cx :fx) :temps))
    (if (> (+ k 1) (temps)) (temps (+ k 1)) nil)))

;; x as an operand an instruction can read directly — (local i name), (cap i name) or (const v)
;; — or nil when it has to be computed first.
(defn compiler-operand (x cx)
  (cond
    (symbol? x)
      (let (r (compiler-resolve x cx))
        (cond
          (nil? r) nil
          (= (head r) 'local) (list 'local (second r) x)
          true (list 'cap (second r) x)))
    (list? x)
      (cond
        (empty? x) (list 'const x)
        (and (= (head x) 'quote) (= (length x) 2)) (list 'const (second x))
        true nil)
    (dict? x) nil
    true (list 'const x)))

;; What a call's head means, if it is a global name: the kind vm-global-kind gives, or nil.
(defn compiler-head-kind (x cx)
  (if (and (list? x) (not (empty? x)) (symbol? (head x))
           (not (dict-has compiler-specials (head x))) (not (compiler-local? (head x) cx)))
    (vm-global-kind (head x))
    nil))

;; Code leaving x's value in temporary d.
(defn compiler-to-reg (x cx d)
  (compiler-use-tmp cx d)
  (let (op (compiler-operand x cx))
    (if op
      (list (list 'move (compiler-tmp d) op))
      (if (symbol? x)
        (list (list 'global (compiler-tmp d) x))
        (let (kind (compiler-head-kind x cx))
          (cond
            (= kind "macro") (compiler-to-reg (vm-macroexpand x) cx d)
            (compiler-reg-call? kind x) (compiler-call-into x cx d kind)
            (compiler-call-at? x kind) (compiler-call-at-into x cx d)
            true (compiler-cat (compiler-to-stack x (dict-set cx :tmp d) kind)
                               (list (list 'pop-to (compiler-tmp d))))))))))

;; x's code for the stack, when compiler-head-kind already said what its head means.
(defn compiler-to-stack (x cx kind)
  (if (nil? kind)
    (compiler-expr x cx false)
    (compiler-global-call x cx false kind)))

;; Each argument into its temporary, from d up, in order.
(defn compiler-args-to (args cx d)
  (if (empty? args)
    (list)
    (compiler-cat (compiler-to-reg (head args) cx d) (compiler-args-to (tail args) cx (+ d 1)))))

;; Is this call worth registers? A builtin of two arguments is a call2, whose operands are read
;; where they are (the arithmetic and the intrinsics run inside it). A function is entered at its
;; argument registers. Any other builtin call is cheaper as stack code: the builtin takes its
;; arguments from the stack anyway.
(defn compiler-reg-call? (kind x)
  (or (= kind "function") (and (= kind "builtin") (= (length x) 3))))

;; A call of a global, its result into temporary d (see compiler-reg-call?). A first operand
;; that is a variable is copied before a second one that must be computed, in case computing it
;; changes the variable; reading a global changes nothing.
(defn compiler-call-into (x cx d kind)
  (let (f (head x) args (tail x))
    (if (= kind "builtin")
      (let (a (compiler-operand (head args) cx)
            b (compiler-operand (second args) cx)
            a-now (and a (or b (= (head a) 'const) (symbol? (second args))))
            a-code (if a-now (list) (compiler-to-reg (head args) cx d))
            b-code (if b (list) (compiler-to-reg (second args) cx (+ d 1))))
        (compiler-use-tmp cx d)
        (compiler-cat a-code b-code
                      (list (list 'call2 (compiler-tmp d) f
                                  (if a-now a (compiler-tmp d))
                                  (if b b (compiler-tmp (+ d 1)))))))
      (do
        (compiler-use-tmp cx d)
        (compiler-cat (compiler-args-to args cx d)
                      (list (list 'call-global (compiler-tmp d) f (compiler-tmp d) (length args))))))))

;; A call of a global, its value left on the stack (or, in tail position, a tail call).
(defn compiler-call-reg (x cx tailp kind)
  (let (d (compiler-tmp-base cx) args (tail x))
    (cond
      (and tailp (= kind "function"))
        (do
          (compiler-use-tmp cx d)
          (compiler-cat (compiler-args-to args cx d)
                        (list (list 'tail-call-global (head x) (compiler-tmp d) (length args)))))
      (= kind "builtin")
        (let (a (compiler-operand (head args) cx) b (and a (compiler-operand (second args) cx)))
          (if b
            (list (list 'call2 'push (head x) a b))
            (compiler-cat (compiler-call-into x cx d kind) (list (list 'push (compiler-tmp d))))))
      true (compiler-cat (compiler-call-into x cx d kind) (list (list 'push (compiler-tmp d)))))))

;; A call compiled with call-at: one whose head is a local variable, a global not known when
;; compiling (a function defined later, or the one being defined), or not a name at all.
(defn compiler-call-at? (x kind)
  (and (nil? kind) (list? x) (not (empty? x))
       (not (and (symbol? (head x)) (dict-has compiler-specials (head x))))))

;; The function into temporary d, then its arguments after it, then call-at: the function is
;; read first, as stack code reads it, so a name that isn't defined fails before any argument
;; is computed.
(defn compiler-call-at-into (x cx d)
  (compiler-use-tmp cx d)
  (compiler-cat (compiler-to-reg (head x) cx d)
                (compiler-args-to (tail x) cx (+ d 1))
                (list (list 'call-at (compiler-tmp d) (compiler-tmp d) (length (tail x))))))

;; The same, its value left on the stack (or, in tail position, a tail call).
(defn compiler-call-at (x cx tailp)
  (let (d (compiler-tmp-base cx))
    (if tailp
      (do
        (compiler-use-tmp cx d)
        (compiler-cat (compiler-to-reg (head x) cx d)
                      (compiler-args-to (tail x) cx (+ d 1))
                      (list (list 'tail-call-at (compiler-tmp d) (length (tail x))))))
      (compiler-cat (compiler-call-at-into x cx d) (list (list 'push (compiler-tmp d)))))))

;; Jump to label unless test is true: a register test needs no trip through the stack.
(defn compiler-jump-unless (test cx label)
  (let (op (compiler-operand test cx))
    (if op
      (list (list 'jump-if-not op label))
      (let (kind (compiler-head-kind test cx) d (compiler-tmp-base cx))
        (cond
          (compiler-reg-call? kind test)
            (compiler-cat (compiler-call-into test cx d kind) (list (list 'jump-if-not (compiler-tmp d) label)))
          (compiler-call-at? test kind)
            (compiler-cat (compiler-call-at-into test cx d) (list (list 'jump-if-not (compiler-tmp d) label)))
          true (compiler-cat (compiler-expr test cx false) (list (list 'jump-if-false label))))))))

;; ── special forms ──────────────────────────────────────────────────────

(defn compiler-special (h x cx tailp)
  (let (n (length x))
    (cond
      (= h 'quote) (compiler-const (if (> n 1) (nth x 1) nil))
      (= h 'if) (if (< n 3) (compiler-interp x) (compiler-if x cx tailp))
      (or (= h 'do) (= h 'begin)) (compiler-body (tail x) cx tailp)
      (= h 'def) (compiler-def x cx)
      (or (= h 'defn) (= h 'defun)) (compiler-defn x cx)
      (or (= h 'fn) (= h 'lambda))
        (if (and (> n 1) (list? (nth x 1)))
          (list (list 'closure (compiler-proto nil (nth x 1) (drop 2 x) cx)))
          (compiler-interp x))
      (= h 'set!)
        (if (and (> n 2) (symbol? (nth x 1)))
          (let (value-code (compiler-expr (nth x 2) cx false))
            (compiler-cat value-code (compiler-store (nth x 1) cx)))
          (compiler-interp x))
      (= h 'let) (if (< n 2) (compiler-interp x) (compiler-let x cx tailp))
      (= h 'cond) (compiler-cond (tail x) cx tailp (compiler-label))
      (= h 'and) (if (= n 1) (compiler-const true) (compiler-andor (tail x) cx tailp 'jump-if-false-or-pop (compiler-label)))
      (= h 'or) (if (= n 1) (compiler-const false) (compiler-andor (tail x) cx tailp 'jump-if-true-or-pop (compiler-label)))
      (= h 'loop) (if (< n 2) (compiler-interp x) (compiler-loop x cx))
      (= h 'recur)
        (compiler-cat
          (reduce (fn (acc a) (append acc (compiler-expr a cx false))) (list) (tail x))
          (list (list 'recur (- n 1))))
      (= h 'try) (compiler-try x cx tailp)
      (= h 'quasiquote) (compiler-qq (if (> n 1) (nth x 1) nil) cx)
      (= h 'for-each) (if (< n 3) (compiler-interp x) (compiler-for-each x cx))
      (= h 'defmacro) (compiler-defmacro x cx)
      true (compiler-interp x))))

(defn compiler-if (x cx tailp)
  (let (else-l (compiler-label)
        end-l (compiler-label)
        test-code (compiler-jump-unless (nth x 1) cx else-l)
        then-code (compiler-expr (nth x 2) cx tailp)
        else-code (if (> (length x) 3) (compiler-expr (nth x 3) cx tailp) (compiler-const nil)))
    (compiler-cat
      test-code
      then-code
      (list (list 'jump end-l) (list 'label else-l))
      else-code
      (list (list 'label end-l)))))

;; A function body, as a proto: a new function whose first slots are its parameters.
(defn compiler-proto (name params body cx)
  (let (fx (compiler-new-fx (dict-get cx :fx))
        block (compiler-new-block fx))
    (for-each p (compiler-param-names params) (compiler-declare p block))
    (let (code (compiler-body body (compiler-enter (dict-set cx :tmp 0) block) true))
      (list 'proto :name name :params params :source body
            :slots ((dict-get fx :slots)) :temps ((dict-get fx :temps))
            :captures (map second ((dict-get fx :caps)))
            :code code))))

(defn compiler-def (x cx)
  (cond
    (< (length x) 3) (compiler-interp x)
    (symbol? (nth x 1))
      (compiler-define (nth x 1) cx (compiler-fn-form? (nth x 2))
                       (fn () (compiler-expr (nth x 2) cx false)))
    ;; (def (name params…) body…)
    (and (list? (nth x 1)) (not (empty? (nth x 1))) (symbol? (head (nth x 1))))
      (let (name (head (nth x 1)))
        (compiler-define name cx true
                         (fn () (list (list 'closure (compiler-proto name (tail (nth x 1)) (drop 2 x) cx))))))
    true (compiler-interp x)))

(defn compiler-defn (x cx)
  (if (and (>= (length x) 3) (symbol? (nth x 1)) (list? (nth x 2)))
    (compiler-define (nth x 1) cx true
                     (fn () (list (list 'closure (compiler-proto (nth x 1) (nth x 2) (drop 3 x) cx)))))
    (compiler-interp x)))

;; The (name value) pairs of a let: flat `(a 1 b 2)` or nested `((a 1) (b 2))`. A pair whose
;; name isn't a symbol binds nothing, as in the interpreter.
(defn compiler-flat-pairs (binds)
  (if (< (length binds) 2)
    (list)
    (let (rest (compiler-flat-pairs (drop 2 binds)))
      (if (symbol? (head binds)) (cons (list (head binds) (second binds)) rest) rest))))

(defn compiler-let-pairs (binds)
  (cond
    (not (list? binds)) (list)
    (empty? binds) (list)
    (symbol? (head binds)) (compiler-flat-pairs binds)
    true (filter (fn (p) (and (list? p) (>= (length p) 2) (symbol? (head p)))) binds)))

;; Each value is computed with the bindings before it in view (let*), then gets its slot.
;; → (code slots)
(defn compiler-bind (pairs block cx)
  (let (code (compiler-box (list)) slots (compiler-box (list)))
    (for-each p pairs
      (let (value-code (compiler-expr (second p) cx false)
            slot (compiler-declare (head p) block))
        (code (compiler-cat (code) value-code (list (list 'init-local slot))))
        (slots (append (slots) (list slot)))))
    (list (code) (slots))))

(defn compiler-let (x cx tailp)
  (let (block (compiler-new-block (dict-get cx :fx))
        inner (compiler-enter cx block)
        binds (compiler-bind (compiler-let-pairs (nth x 1)) block inner)
        body (compiler-body (drop 2 x) inner tailp))
    (compiler-cat (compiler-clears block) (head binds) body)))

;; Flat cond: test, result, test, result…; `else`, `otherwise` and `true` always match.
(defn compiler-cond (clauses cx tailp end-l)
  (if (< (length clauses) 2)
    (compiler-cat (compiler-const nil) (list (list 'label end-l)))
    (let (test (head clauses) result (second clauses) next-l (compiler-label))
      (if (and (symbol? test) (compiler-member? test '(else otherwise)))
        (compiler-cat (compiler-expr result cx tailp) (list (list 'label end-l)))
        (let (test-code (compiler-jump-unless test cx next-l)
              result-code (compiler-expr result cx tailp))
          (compiler-cat
            test-code
            result-code
            (list (list 'jump end-l) (list 'label next-l))
            (compiler-cond (drop 2 clauses) cx tailp end-l)))))))

;; and / or: every value but the last can end the form early.
(defn compiler-andor (forms cx tailp jump end-l)
  (if (empty? (tail forms))
    (compiler-cat (compiler-expr (head forms) cx tailp) (list (list 'label end-l)))
    (let (first-code (compiler-expr (head forms) cx false))
      (compiler-cat
        first-code
        (list (list jump end-l))
        (compiler-andor (tail forms) cx tailp jump end-l)))))

;; (loop (a 1 b 2) body): the body is one form; `recur` rebinds the slots and starts it again.
(defn compiler-loop (x cx)
  (let (block (compiler-new-block (dict-get cx :fx))
        inner (compiler-enter cx block)
        binds (compiler-bind (if (list? (nth x 1)) (compiler-flat-pairs (nth x 1)) (list)) block inner)
        body (if (> (length x) 2) (compiler-expr (nth x 2) inner false) (compiler-const nil)))
    (compiler-cat
      (compiler-clears block)
      (head binds)
      (list (cons 'loop-slots (second binds)))
      body
      (list (list 'end-loop)))))

;; (try body… (catch e handler…)). The body is never a tail call: its error must land here.
(defn compiler-try (x cx tailp)
  (let (last-form (last x)
        catch? (and (> (length x) 1) (list? last-form) (not (empty? last-form)) (= (head last-form) 'catch))
        body (if catch? (take (- (length x) 2) (tail x)) (tail x))
        catch-l (compiler-label)
        end-l (compiler-label)
        body-code (compiler-body body cx false)
        catch-code (if catch? (compiler-catch last-form cx tailp) (list (list 'pop) (list 'const nil))))
    (compiler-cat
      (list (list 'try catch-l))
      body-code
      (list (list 'end-try) (list 'jump end-l) (list 'label catch-l))
      catch-code
      (list (list 'label end-l)))))

;; The handler runs with the error dict on the stack, bound to the catch name if there is one.
(defn compiler-catch (c cx tailp)
  (let (name (if (> (length c) 1) (nth c 1) nil)
        block (compiler-new-block (dict-get cx :fx))
        inner (compiler-enter cx block)
        bind (if (symbol? name)
               (list (list 'init-local (compiler-declare name block)))
               (list (list 'pop)))
        body (compiler-body (drop 2 c) inner tailp))
    (compiler-cat (compiler-clears block) bind body)))

;; Is x a two-element form headed by the symbol name — (unquote v), (unquote-splicing v)?
(defn compiler-unquote? (x name)
  (and (list? x) (= (length x) 2) (= (head x) name)))

;; A quasiquote template: lists are rebuilt, ,x is evaluated, ,@x is spliced in, anything else
;; (dicts included) stays as written.
(defn compiler-qq (e cx)
  (cond
    (not (list? e)) (compiler-const e)
    (compiler-unquote? e 'unquote) (compiler-expr (second e) cx false)
    true (compiler-cat
           (reduce (fn (acc it)
                     (append acc (if (compiler-unquote? it 'unquote-splicing)
                                   (compiler-expr (second it) cx false)
                                   (compiler-qq it cx))))
                   (list) e)
           (list (cons 'make-list
                       (map (fn (it) (if (compiler-unquote? it 'unquote-splicing) 'splice 'item)) e))))))

;; (for-each var list body…): the body runs once per element, in a fresh scope binding var, and
;; the form is nil. A var that isn't a symbol makes the whole form nil, list unevaluated.
(defn compiler-for-each (x cx)
  (let (var (nth x 1))
    (if (not (symbol? var))
      (compiler-const nil)
      (let (list-code (compiler-expr (nth x 2) cx false)
            block (compiler-new-block (dict-get cx :fx))
            inner (compiler-enter cx block)
            slot (compiler-declare var block)
            top-l (compiler-label)
            end-l (compiler-label)
            body (reduce (fn (acc f) (compiler-cat acc (compiler-expr f inner false) (list (list 'pop))))
                         (list) (drop 3 x)))
        (compiler-cat
          list-code
          (compiler-const 0)
          (list (list 'label top-l) (list 'next-item end-l))
          (compiler-clears block)
          (list (list 'init-local slot))
          body
          (list (list 'jump top-l) (list 'label end-l))
          (compiler-const nil))))))

;; (defmacro name (params) body…): the expander is compiled like a function body; it runs, at
;; compile time, on the unevaluated argument forms.
(defn compiler-defmacro (x cx)
  (if (and (>= (length x) 3) (symbol? (nth x 1)) (list? (nth x 2)))
    (compiler-define (nth x 1) cx true
                     (fn () (list (list 'macro (compiler-proto (nth x 1) (nth x 2) (drop 3 x) cx)))))
    (compiler-interp x)))

;; ── entry points ───────────────────────────────────────────────────────

;; The bytecode for one top-level form, as a (proto …) form.
(defn compile (form)
  (let (fx (compiler-new-fx nil)
        code (compiler-expr form {:lex (list) :fx fx :declared (dict-get fx :declared) :tmp 0} true))
    (list 'proto :name nil :params (list) :source (list form)
          :slots ((dict-get fx :slots)) :temps ((dict-get fx :temps)) :captures (list) :code code)))

;; Compile a top-level form and run it, in the global scope.
(defn compile-run (form) (vm-run (compile form)))
